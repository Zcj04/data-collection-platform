# 环境变量模板（复制为 .env 后填写真实值）
# 凭证不写死在这里，通过凭证管理页加密存储
# 此文件仅作为配置参考

# 数据库（本地MySQL，各爬虫脚本场地映射用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=store_mapping_db

# Streamlit
STREAMLIT_SERVER_PORT=8501

# AI 分析师（DeepSeek，密钥请勿提交到代码库）
ANALYST_API_KEY=
ANALYST_BASE_URL=https://api.deepseek.com
ANALYST_MODEL=deepseek-v4-flash

# 鲸舰平台当前仅提供 HTTP。优先填写公司自建 HTTPS 网关地址。
JINGJIAN_LOGIN_BASE_URL=
JINGJIAN_DATA_BASE_URL=
# 仅在链路已通过专线、VPN 或受控内网隔离并完成风险确认后设为 1。
WORKBUDDY_ALLOW_INSECURE_JINGJIAN_HTTP=0

# 可选：生产告警接收地址，必须为 HTTPS；留空时仅保存在本地 alert_events。
WORKBUDDY_ALERT_WEBHOOK_URL=

# 平台侧业务 ID（真实值写在 .env，勿提交）
MEITUAN_SHOP_IDS=
DOUYIN_ROOT_ACCOUNT_IDS=
STARTHING_RAM_SYSTEM=
STARTHING_VERIFY_CODE=
STARTHING_PINBALL_EQUIPMENT_ID=
STARTHING_PINBALL_TENANT_ID=
STARTHING_PINBALL_ORG_ID=
KPAY_SID=
NEW_SYSTEM_APPID=
NEW_SYSTEM_DEVICEID=
